      "recordEk": "entity-1",
      "expected": {"valid": true, "appliedEffectIds": ["issuance-1"], "ignoredCandidateIndexes": [1], "bilateralBinding": {"initialEntityThumbprint": "UDDReOZl1ipXAfp9wYsm13sDBMK5og--QWdBjzuf6o4", "currentEntityThumbprint": "UDDReOZl1ipXAfp9wYsm13sDBMK5og--QWdBjzuf6o4"}}
    },
    {
      "id": "ignored-entity-key-rotation-does-not-bind-new-key",
      "candidates": ["issuance", "entity-rotation-wrong-previous-signer"],
      "recordEk": "entity-2",
      "expected": {"valid": false}
    },
    {
      "id": "entity-key-rotation-with-invalid-new-signature-is-ignored",
      "candidates": ["issuance", "entity-rotation-invalid-new-signature"],
      "recordEk": "entity-1",
      "expected": {"valid": true, "appliedEffectIds": ["issuance-1"], "ignoredCandidateIndexes": [1], "bilateralBinding": {"initialEntityThumbprint": "UDDReOZl1ipXAfp9wYsm13sDBMK5og--QWdBjzuf6o4", "currentEntityThumbprint": "UDDReOZl1ipXAfp9wYsm13sDBMK5og--QWdBjzuf6o4"}}
    },
    {

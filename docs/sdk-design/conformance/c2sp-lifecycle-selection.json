      "expected": {"valid": true, "appliedEffectIds": ["issuance-1", "revocation-large-exponent-number"], "ignoredCandidateIndexes": [], "identityState": "REVOKED"}
    },
    {
      "id": "unauthenticated-migration-before-genesis-is-ignored",
      "candidates": ["bad-signature-migration", "issuance"],
      "priorHistoryVerified": true,
      "priorAppliedEffectIds": ["issuance-prior"],
      "expected": {"valid": true, "appliedEffectIds": ["issuance-1"], "ignoredCandidateIndexes": [0]}
    },
    {
      "id": "shared-kid-label-does-not-select-keys",
      "candidates": ["shared-kid-issuance"],
      "expected": {"valid": true, "appliedEffectIds": ["issuance-shared-kid"], "ignoredCandidateIndexes": []}
    },
    {

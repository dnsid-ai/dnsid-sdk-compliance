      "candidates": ["issuance", "entity-rotation"],
      "recordEk": "entity-2",
      "expected": {"valid": true, "appliedEffectIds": ["issuance-1", "entity-rotation-1"], "ignoredCandidateIndexes": [], "bilateralBinding": {"initialEntityThumbprint": "UDDReOZl1ipXAfp9wYsm13sDBMK5og--QWdBjzuf6o4", "currentEntityThumbprint": "r4thRn8KdhhgGDrzOwmSwySqMcXeIdd9SG333J-ZNtU"}}
    },
    {
      "id": "entity-key-rotation-rejects-record-with-issuance-key",
      "candidates": ["issuance", "entity-rotation"],
      "recordEk": "entity-1",
      "expected": {"valid": false}
    },
    {
      "id": "chained-entity-key-rotations-bind-latest-key",
      "candidates": ["issuance", "entity-rotation", "entity-rotation-second"],
      "recordEk": "entity-3",
      "expected": {"valid": true, "appliedEffectIds": ["issuance-1", "entity-rotation-1", "entity-rotation-2"], "ignoredCandidateIndexes": [], "bilateralBinding": {"initialEntityThumbprint": "UDDReOZl1ipXAfp9wYsm13sDBMK5og--QWdBjzuf6o4", "currentEntityThumbprint": "8TlG3IhiRH5sWhsIGSSRnAqf9zyhEl1ir4t4cbTRCk0"}}
    },
    {

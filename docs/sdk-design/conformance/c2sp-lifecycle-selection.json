      "expected": {"valid": true, "appliedEffectIds": ["migration-in-1", "rotation-1"], "stitchedEffectIds": ["issuance-prior", "migration-in-1", "rotation-1"]}
    },
    {
      "id": "inbound-migration-without-verifiable-prior-history-is-fatal",
      "candidates": ["inbound-migration"],
      "priorHistoryVerified": false,
      "expected": {"valid": false, "failingCandidateIndex": 0, "errorCategory": "INVALID_MIGRATION"}
    },
    {
      "id": "revocation-with-fractional-number-extension-is-applied",
      "candidates": ["issuance", "revocation-fractional-number"],
      "expected": {"valid": true, "appliedEffectIds": ["issuance-1", "revocation-fractional-number"], "ignoredCandidateIndexes": [], "identityState": "REVOKED"}
    },
    {
      "id": "revocation-with-small-exponent-number-extension-is-applied",
      "candidates": ["issuance", "revocation-small-exponent-number"],
      "expected": {"valid": true, "appliedEffectIds": ["issuance-1", "revocation-small-exponent-number"], "ignoredCandidateIndexes": [], "identityState": "REVOKED"}
    },
    {
      "id": "revocation-with-large-exponent-number-extension-is-applied",
